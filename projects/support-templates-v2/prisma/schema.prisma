generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id        String   @id
  title     String
  category  String
  tags      String[]
  body      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
