{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(npm run:*)",
      "Read",
      "Edit"
    ],
    "deny": [
      "Read(.env)",
      "Bash(cat .env:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PostToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "npm run typecheck 2>&1 | tail -5"
      }]
    }]
  }
}
